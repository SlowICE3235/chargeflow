# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe / Asaas (escolha um)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# ou
ASAAS_API_KEY=your-asaas-key
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-secret

# WhatsApp API (Evolution API ou Z-API)
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=your-evolution-api-key
# ou
ZAPI_INSTANCE_ID=your-instance-id
ZAPI_TOKEN=your-token
ZAPI_CLIENT_TOKEN=your-client-token

# Cron Job Secret
CRON_SECRET=your-cron-secret-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:7100
